{{- $articles := slice -}}
{{- range where site.RegularPages "Section" "posts" -}}
  {{- $cat := dict -}}
  {{- with .GetTerms "categories" }}{{ $t := index . 0 }}{{ $cat = dict "name" $t.LinkTitle "slug" ($t.File.ContentBaseName | default $t.Title | urlize) "url" $t.Permalink }}{{ end -}}
  {{- $item := dict
      "title" .Title
      "url" .Permalink
      "markdown_url" (.OutputFormats.Get "markdown").Permalink
      "description" .Description
      "category" $cat
      "published" (.Date.Format "2006-01-02")
      "updated" (.Lastmod.Format "2006-01-02")
      "author" (.Params.author | default site.Params.author)
      "reading_minutes" .ReadingTime
      "takeaways" (.Params.takeaways | default slice)
      "faq" (.Params.faq | default slice) -}}
  {{- with .Params.lastVerified }}{{ $item = merge $item (dict "last_verified" ((time .).Format "2006-01-02")) }}{{ end -}}
  {{- $articles = $articles | append $item -}}
{{- end -}}
{{- $states := slice -}}
{{- range site.Data.states -}}
  {{- $page := site.GetPage (printf "/posts/%s-electricity-rate-changes-2026" .slug) -}}
  {{- $s := dict "state" .name "status" "coming_soon" -}}
  {{- if $page }}{{ $s = dict "state" .name "status" "available" "url" $page.Permalink "markdown_url" ($page.OutputFormats.Get "markdown").Permalink }}{{ end -}}
  {{- $states = $states | append $s -}}
{{- end -}}
{{- dict "site" site.Title "url" site.Home.Permalink "description" site.Params.description "license_and_citation" (absURL "for-ai/") "llms_txt" (absURL "llms.txt") "llms_full_txt" (absURL "llms-full.txt") "generated" (now.Format "2006-01-02") "articles" $articles "rates_by_state" $states | jsonify (dict "indent" "  ") -}}
